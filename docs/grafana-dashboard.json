{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "title": "NR Sandbox — Process Visibility Demo",
  "uid": "nr-sandbox-demo-v1",
  "tags": ["nr-sandbox", "otel", "process-monitoring"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "pluginId": "prometheus",
        "label": "Datasource",
        "hide": 0,
        "current": {},
        "options": [],
        "query": "prometheus",
        "refresh": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU Usage %",
      "description": "Active CPU time across all cores (excludes idle). Collected via OTel hostmetrics receiver.",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "(1 - avg(rate(system_cpu_time_seconds_total{state=\"idle\"}[5m]))) * 100",
          "legendFormat": "CPU Active %",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory Usage",
      "description": "Host memory breakdown. Used + cached + free = total RAM.",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "system_memory_usage_bytes{state=\"used\"}",
          "legendFormat": "Used",
          "refId": "A"
        },
        {
          "expr": "system_memory_usage_bytes{state=\"cached\"}",
          "legendFormat": "Cached",
          "refId": "B"
        },
        {
          "expr": "system_memory_usage_bytes{state=\"free\"}",
          "legendFormat": "Free",
          "refId": "C"
        }
      ]
    },
    {
      "id": 3,
      "type": "table",
      "title": "Process Inventory — What's Actually Running?",
      "description": "Every process visible to the OTel collector. Redis and nginx are 'dark' to most APM tools — this table lights them up.",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "process_executable_name" },
            "properties": [
              { "id": "displayName", "value": "Process" },
              { "id": "custom.width", "value": 200 }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Value" },
            "properties": [
              { "id": "displayName", "value": "Memory (RSS)" },
              { "id": "unit", "value": "bytes" },
              {
                "id": "custom.displayMode",
                "value": "color-background"
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "green", "value": null },
                    { "color": "yellow", "value": 52428800 },
                    { "color": "red", "value": 104857600 }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [{ "displayName": "Memory (RSS)", "desc": true }],
        "footer": { "show": false }
      },
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "process_name" } },
        { "id": "merge", "options": {} }
      ],
      "targets": [
        {
          "expr": "topk(25, sum by (process_executable_name) (process_memory_usage_bytes))",
          "legendFormat": "{{process_executable_name}}",
          "refId": "A",
          "instant": true,
          "format": "table"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "HTTP Request Rate (FastAPI)",
      "description": "Requests/sec to the FastAPI app, auto-instrumented via OpenTelemetry FastAPIInstrumentor.",
      "gridPos": { "x": 0, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "sum(rate(http_server_duration_milliseconds_count[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        },
        {
          "expr": "sum(rate(http_server_request_duration_seconds_count[1m]))",
          "legendFormat": "req/s (alt)",
          "refId": "B"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "System Load Average",
      "description": "1m / 5m / 15m load averages from the host.",
      "gridPos": { "x": 12, "y": 18, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        }
      },
      "options": {
        "tooltip": { "mode": "multi", "sort": "desc" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "targets": [
        {
          "expr": "system_cpu_load_average_1m",
          "legendFormat": "1m",
          "refId": "A"
        },
        {
          "expr": "system_cpu_load_average_5m",
          "legendFormat": "5m",
          "refId": "B"
        },
        {
          "expr": "system_cpu_load_average_15m",
          "legendFormat": "15m",
          "refId": "C"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Total Processes Monitored",
      "description": "Count of distinct processes visible to OTel. This number is the core demo — most APM tools show 1 (just the app).",
      "gridPos": { "x": 0, "y": 26, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(sum by (process_executable_name) (process_memory_usage_bytes))",
          "legendFormat": "processes",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Metrics Flowing (last 5m)",
      "gridPos": { "x": 8, "y": 26, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "count(system_cpu_time_seconds_total)",
          "legendFormat": "Active CPU series",
          "refId": "A",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "stat",
      "title": "Memory Used %",
      "gridPos": { "x": 16, "y": 26, "w": 8, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        }
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background"
      },
      "targets": [
        {
          "expr": "system_memory_usage_bytes{state=\"used\"} / (system_memory_usage_bytes{state=\"used\"} + system_memory_usage_bytes{state=\"free\"} + system_memory_usage_bytes{state=\"cached\"}) * 100",
          "legendFormat": "Memory %",
          "refId": "A",
          "instant": true
        }
      ]
    }
  ]
}
